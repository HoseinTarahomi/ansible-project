{
  "data-root": "{{ docker_data_root }}",
  "insecure-registries": {{ docker_insecure_registries | to_json }},
  "registry-mirrors": [
    "{{ docker_registry_mirror }}"
  ],
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "{{ docker_log_max_size }}",
    "max-file": "{{ docker_log_max_file }}"
  }
}
