services:
  traefik:
    image: traefik:v3.6
    container_name: traefik
    restart: always
    command:
      - "--api.insecure=true"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.docker.network=proxy"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--providers.file.filename=/etc/traefik/dynamic_conf.yml"
      - "--providers.file.watch=true"
    ports:
      - "80:80"
      - "443:443"
      - "8080:8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /etc/letsencrypt/archive/ht22.ir/fullchain1.pem:/etc/traefik/certs/fullchain.pem:ro
      - /etc/letsencrypt/archive/ht22.ir/privkey1.pem:/etc/traefik/certs/privkey.pem:ro
      - /opt/traefik/dynamic_conf.yml:/etc/traefik/dynamic_conf.yml:ro
    networks:
      - proxy

networks:
  proxy:
    external: true
